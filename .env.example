# Скопируйте этот файл в .env и заполните. Файл .env никому не отправляйте и не коммитьте.

# Токен бота из платформы MAX для партнёров
BOT_TOKEN=

# Публичный https-адрес сервера (туннель или хостинг), без слэша в конце.
# Этот же адрес + /miniapp.html указывается в настройках бота как адрес Mini App.
PUBLIC_URL=

# Порт локального сервера
PORT=8080

# Пароль веб-панели вуза и код для команды боту «/staff КОД» (подписка сотрудника на уведомления)
PANEL_PASSWORD=uniflow
STAFF_CODE=uniflow

# Имя бота без @ (если пусто — сервер возьмёт его из MAX)
BOT_USERNAME=

# Разрешить вход в Mini App из обычного браузера (для разработки). В MAX вход всегда проверяется подписью.
ALLOW_BROWSER_LOGIN=1
# Кнопка «Демо-вход: тестовый студент» в боте (пока Mini App не зарегистрирован в MAX). 0 — выключить
DEMO_BOT_LOGIN=1

# Кнопки open_app вместо ссылок max.ru/<бот>?startapp=… (включите, если ссылки открываются не в Mini App)
OPEN_APP_BUTTONS=0

# ИИ-маршрутизатор Jev (TypeSafe AI, необязательно). Ключ: https://console.typesafe.ai/keys
# Jev выбирает услугу по сообщению студента и значения полей-списков; чего не хватает — бот уточняет кнопками.
# Через Polza.AI (оплата в рублях): JEV_API_URL=https://polza.ai/api/v1/systemone и JEV_MODEL=typesafe/jev
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_API_URL=

# Запасной ИИ-маршрутизатор (необязательно): любой OpenAI-совместимый /chat/completions.
# Если пусто — бот распознаёт запросы по ключевым фразам из конструктора услуг.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ——— Docker ———
# Порт на хосте для приложения (docker compose)
APP_PORT=8080
# Домен сервера для https через Caddy (docker compose --profile https up -d)
# Свой домен или бесплатный поддомен DuckDNS, например uniflow302.duckdns.org
DOMAIN=
